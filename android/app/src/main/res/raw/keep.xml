<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds shrink unreferenced resources. The notification small icon is
  referenced from Dart (AndroidInitializationSettings('ic_status')), which the
  shrinker cannot see, so it must be kept explicitly.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_status" />

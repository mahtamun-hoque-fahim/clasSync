<?xml version="1.0" encoding="utf-8"?>
<!-- The widget is locked to the light theme, so a single set of colors, never
     configuration-qualified: the launcher's night config must not recolor it.
     The tones follow the app's M3 light scheme. -->
<resources>
    <color name="widget_bg">#FFF7F9FB</color>
    <color name="widget_on_bg">#FF000000</color>
    <color name="widget_dim">#FF60646B</color>
    <color name="widget_accent">#FF009688</color>
</resources>

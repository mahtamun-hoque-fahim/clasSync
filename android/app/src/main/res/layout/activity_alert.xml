<?xml version="1.0" encoding="utf-8"?>
<!-- The lock-screen alert. One line to glance at, nothing else to read on a
     screen the phone is still locked behind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/alert_background"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <View
        android:layout_width="44dp"
        android:layout_height="3dp"
        android:background="@color/alert_accent" />

    <TextView
        android:id="@+id/alert_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/alert_title"
        android:textSize="26sp"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/alert_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/alert_body"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/alert_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/alert_dismiss_hint"
        android:textColor="@color/alert_hint"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textAllCaps="true" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The themed card lives on an inner view, not the layout root: the MIUI
     host ignores runtime background changes on the RemoteViews root and keeps
     the initial-layout background, so the root stays transparent and only
     widgetCard is swapped (light/dark) from code. Reference layout: white
     panel with the state text on the left, the accent-gradient icon tile on
     the right (drawn as one bitmap from code, so the accent follows the app).
     Colors are set from code so they come from the widget snapshot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widgetCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_bg"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/widgetText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nowLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="NOW" />

            <TextView
                android:id="@+id/nowMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Open ClasSync" />

            <TextView
                android:id="@+id/stateSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/nextLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="NEXT" />
        </LinearLayout>

        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/widget_state_icon"
            android:src="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The themed card lives on an inner view, not the layout root: the MIUI
     host ignores runtime background changes on the RemoteViews root and keeps
     the initial-layout background, so the root stays transparent and only
     widgetCard is swapped (light/dark) from code. Reference layout: the
     accent-gradient state panel fills the card's right 35% (one bitmap from
     code, so the accent follows the app and the right corners stay rounded)
     and the text layer sits over the full card, so a long headline runs over
     the panel instead of being clipped at the old 65% column edge. Colors
     are set from code so they come from the widget snapshot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widgetCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg">

        <!-- Panel layer: the state panel keeps the reference grid's 35%
             width on the right through a spacer + weight pair, so the split
             holds at any placed width. The bitmap is drawn from code at
             exactly this size (right corners rounded like the card's). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="65" />

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:scaleType="fitXY"
                android:contentDescription="@string/widget_state_icon"
                android:src="@android:color/transparent" />
        </LinearLayout>

        <!-- Text layer: full card width over the panel, same paddings and
             vertical gravity as the old 65% column, so the placed geometry
             of every line is unchanged. -->
        <LinearLayout
            android:id="@+id/widgetText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/nowLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingMultiplier="0.4"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Open ClasSync" />

            <!-- Negative top margins pull each line up into the previous
                 line's empty font-box space: single-line TextViews ignore
                 lineSpacingMultiplier, so this is the only remaining
                 line-height lever (clas43 proved multipliers do nothing
                 here). The dial is user-driven: -5dp halved the ~22px gaps
                 (measured clas63), then one "1x more" step added 2.5dp back
                 (gaps land ~17px). Stays inside the empty font-box zone, so
                 glyphs cannot collide. -->
            <TextView
                android:id="@+id/nowMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2.5dp"
                android:textSize="20sp"
                android:lineSpacingMultiplier="0.4"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#FFFFFF"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="1"
                android:text="" />

            <TextView
                android:id="@+id/stateSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2.5dp"
                android:textSize="13sp"
                android:lineSpacingMultiplier="0.4"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/nextLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:textSize="13sp"
                android:lineSpacingMultiplier="0.4"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="NEXT" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
